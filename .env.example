# Web server
PORT=3000
PUBLIC_BASE_URL=https://your-domain.example
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
PLACE_NAME=Casa Nocturna

# Your Roblox Open Cloud credential. NEVER put this key in public/index.html.
ROBLOX_API_KEY=
ROBLOX_CREATOR_TYPE=group
ROBLOX_CREATOR_ID=

# Open Cloud Assets API adapter.
# The defaults below follow the commonly used Assets API v1 shape, but Roblox can change endpoints.
# Override these values if your current Roblox docs/account use a different route.
ROBLOX_UPLOAD_URL=https://apis.roblox.com/assets/v1/assets
ROBLOX_OPERATION_BASE_URL=https://apis.roblox.com/assets/v1/operations

# When true, no Roblox request is made; fake asset IDs are generated for testing.
SIMULATE_ROBLOX=false

# Audio processing
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
OUTPUT_FORMAT=mp3
OUTPUT_BITRATE=192k
ROBLOX_MAX_UPLOAD_SECONDS=360
MAX_UPLOAD_MB=200

# Game sync endpoint protection. Put the same token in RobloxSync.server.lua.
GAME_SYNC_TOKEN=replace-with-a-second-long-random-token

# Optional: public URL where the Roblox server fetches /api/game/library.
# Example: https://music.example.com
GAME_SYNC_BASE_URL=
